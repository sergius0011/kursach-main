<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient
                android:startColor="@color/warm_green_start"
                android:endColor="@color/warm_green_end"
                android:angle="90"/>
            <stroke
                android:width="2dp"
                android:color="@color/warm_green_stroke"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient
                android:startColor="@color/warm_gray_start"
                android:endColor="@color/warm_gray_end"
                android:angle="90"/>
            <stroke
                android:width="2dp"
                android:color="@color/warm_gray_stroke"/>
        </shape>
    </item>
</selector>